# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API).
# The publishable key is meant for the browser; data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google login is configured in the Supabase dashboard
# (Authentication → Sign In / Providers → Google), not here.


# Google Gemini (label scan + price search), free tier. Server only - never NEXT_PUBLIC_.
# Create at https://aistudio.google.com/apikey and set it in Vercel too.
GEMINI_API_KEY=
# Optional: Gemini model to try first (default gemini-flash-latest, with fallbacks).
# GEMINI_MODEL=

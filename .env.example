# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API).
# The publishable key is meant for the browser; data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google login is configured in the Supabase dashboard
# (Authentication → Sign In / Providers → Google), not here.

# Server-only secrets for later phases - never prefix with NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=
